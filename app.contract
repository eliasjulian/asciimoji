// Asciimoji: the wordmark, a grid of kaomoji, and a short sheet for how to
// copy. The page uses the app's own black and white. The wordmark and the
// sheet's close button are liquid glass, and the sheet opens only as tall
// as those two steps.
shape Catalog
  items: string[]
  count: number
  unique: number

routes nav
  home "/"
    menu "/menu"

component Asciimoji
  resource catalog = loadEmoji() as shape Catalog else empty(count=0, unique=0)
  state copied = ""
  action copy(item: string)
    copyText(item)
    haptic("success")
    copied = item
  action dismiss
    copied = ""
  action openMenu
    nav = push(nav, "/menu")
  action follow(url: string)
    nav = go(nav, url)
  action back
    nav = back(nav)
  task clear when copied != "" key=copied
    after(4000, dismiss)
  view
    main testId="root" navigationKey=`${top(nav).id}` navigationBack="close" navigate=follow width="100%" height="100%" background-color="surface.page" color="ink"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="grid" testId="home" position="absolute" inset=0 display="flex" flex-direction="column" background-color="surface.page" color="ink"
            header appearance="none" display="flex" align-items="center" padding="16px 20px"
              button appearance="none" press=openMenu aria-label="How to copy and paste" testId="logo" backgroundMaterial="glass" padding="4px 8px"
                image "symbol:icon.wordmark" width=180 height=35
            scroll id="grid" flex=1 min-height=0
              view display="grid" width="100%" gap=2 grid-template-columns="repeat(auto-fill, minmax(min(100%, 8.125rem), 1fr))"
                for item, i in catalog.items key=item
                  button appearance="none" display="flex" flex-direction="column" align-items="center" justify-content="center" width="100%" min-height="7.8125rem" padding=12 box-sizing="border-box" background-color="surface.cell" color="ink" press=copy(item) testId=`cell-${i}`
                    :active
                      background-color="surface.pressed"
                    text item text-align="center" overflow-wrap="anywhere"
              column align-items="center" gap=20 padding="24px 16px 48px"
                text "Tap to copy, paste anywhere." font="-exact-title3" color="ink" text-align="center" testId="hint"
                text "(｡◕‿‿◕｡)" font="-exact-title3" color="ink" testId="footer-mark"
            if copied != ""
              text `Boom, copied. ${copied}` role="status" testId="copied" pointer-events="none" position="absolute" left=20 right=20 bottom="calc(env(safe-area-inset-bottom) + 24px)" z-index=10 padding=16 text-align="center" font="-exact-body" background-color="ink" color="surface.page"
        if e.name == "menu"
          column navigationKey=`${e.id}` navigationPresentation="modal" navigationDetent="fit-content" navigationGrabber="visible" testId="menu-sheet" display="flex" flex-direction="column" color="ink"
            header display="flex" align-items="center"
              text "Copy and paste" role="heading" aria-level=2 flex=1
              button id="close" press=back aria-label="Close" testId="close" buttonStyle="glass"
                image "symbol:close"
            column gap=24 padding="8px 30px 32px"
              text "1 – tap to copy" font="-exact-title3" color="ink" testId="step-1"
              text "2 – paste anywhere" font="-exact-title3" color="ink" testId="step-2"
              image "symbol:icon.mark" aria-label="Asciimoji" testId="mark" width=38 height=37
