{
  "expo": {
    "name": "Asciimoji",
    "slug": "asciimoji-app",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/appicon.png",
    "scheme": "asciimoji",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "com.eliasjulian.asciimoji",
      "supportsTablet": true
    },
    "android": {
      "package": "com.eliasjulian.asciimoji",
      "adaptiveIcon": {
        "foregroundImage": "./assets/appicon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/appicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/appicon.png",
          "imageWidth": 120,
          "backgroundColor": "#000000"
        }
      ],
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
